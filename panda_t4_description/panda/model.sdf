      <ros>
        <namespace/>
        <remapping>odom:=sim_ground_truth_pose</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>62</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
