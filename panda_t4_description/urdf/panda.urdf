  <!-- Robot -->
  <!--       -->
  <!-- Dummy world link that the robot is fixed to -->
  <!-- <xacro:panda_dummy_link
    link_name="${world_name}"
    gazebo_preserve_fixed_joint="$(arg gazebo_preserve_fixed_joint)"
  /> -->
